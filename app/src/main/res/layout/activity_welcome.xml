<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_tornasol"
    tools:context=".WelcomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- LOGO IMAGEVIEW -->
            <ImageView
                android:id="@+id/imgVLogoBienvenida"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="24dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_task_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TITLE TEXTVIEW -->
            <TextView
                android:id="@+id/txtVTituloBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/aw_titulo"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/imgVLogoBienvenida" />

            <!-- SUBTITLE TEXTVIEW -->
            <TextView
                android:id="@+id/txtVSubtituloBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/aw_subtitulo"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/txtVTituloBienvenida" />

            <!-- FEATURE TABLELAYOUT INSIDE CARDVIEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/crdTablaCaracteristicas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/txtVSubtituloBienvenida">

                <TableLayout
                    android:id="@+id/tblCaracteristicasBienvenida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_tornasol"
                    android:padding="16dp"
                    android:stretchColumns="*">

                    <!-- Table Header Row -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/aw_tbl_header_feature"
                            android:textColor="@color/accent_purple"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/aw_tbl_header_status"
                            android:textColor="@color/accent_purple"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/card_stroke" />

                    <!-- Feature Row 1 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/aw_tbl_feat1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/aw_tbl_act"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Feature Row 2 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/aw_tbl_feat2"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/aw_tbl_act"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Feature Row 3 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/aw_tbl_feat3"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="@string/aw_tbl_act"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>

                </TableLayout>
            </androidx.cardview.widget.CardView>

            <!-- PROGRESS BAR INITIALIZATION -->
            <ProgressBar
                android:id="@+id/prgBCargaBienvenida"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:progressTint="@color/accent_purple"
                app:layout_constraintTop_toBottomOf="@id/crdTablaCaracteristicas" />

            <!-- ACTION BUTTONS (LinearLayout, Button) -->
            <LinearLayout
                android:id="@+id/lyBotonesBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/prgBCargaBienvenida">

                <Button
                    android:id="@+id/btnIrTareas"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_button_tornasol"
                    android:onClick="abrirTaskMaster"
                    android:text="@string/aw_btn_ir_tareas"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnIrLogin"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:onClick="abrirLogin"
                    android:text="@string/aw_btn_comenzar"
                    android:textColor="@color/accent_purple"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
